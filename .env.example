# Copie este arquivo para .env.local e preencha com um projeto Supabase
# exclusivo do Minha Rotina. Não use chaves de outros aplicativos.
#
# No painel: Project Settings > API Keys.
# Use a publishable key (sb_publishable_...). Não coloque a secret key aqui.

NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua_chave

# Origem pública usada nos links de confirmação de e-mail e de recuperação.
# Local: http://localhost:3000 ou http://localhost:3001, conforme a porta do `next dev`.
# Produção: a origem HTTPS do aplicativo. No painel Auth, Site URL e Redirect URLs
# precisam incluir essa origem com o caminho /auth/confirm.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Leitura de PDF, imagem e áudio. As três precisam existir juntas, só no servidor.
# Sem elas, a importação guarda o arquivo e espera a revisão manual.
# Não use o prefixo NEXT_PUBLIC_ nestas variáveis e não coloque a secret key do Supabase aqui.
# IMPORT_AI_API_KEY=
# IMPORT_AI_BASE_URL=https://api.openai.com/v1
# IMPORT_AI_MODEL=
